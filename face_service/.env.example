# Face Service Environment Variables
# Sao chép file này thành .env và điền giá trị thật

# API Security Key (PHP gửi key này trong header X-API-Key)
FACE_SERVICE_API_KEY=change-me-to-a-random-secret-key

# Cổng chạy service (mặc định 8000)
PORT=8000

# Host binding (0.0.0.0 để cho phép kết nối từ ngoài)
HOST=127.0.0.1

# Anti-Spoofing threshold (0.0 - 1.0, càng cao càng nghiêm ngặt)
SPOOF_THRESHOLD=0.6

# Face Recognition threshold (cosine similarity, càng cao càng nghiêm ngặt)
RECOGNITION_THRESHOLD=0.4

# Thư mục chứa model weights
WEIGHTS_DIR=weights
